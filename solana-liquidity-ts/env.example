# Database Configuration
DATABASE_URL="postgresql://user:password@localhost:5432/solana_liquidity"

# Redis Configuration
REDIS_URL="redis://localhost:6379"

# Solana RPC Endpoints (comma-separated)
SOLANA_RPC_ENDPOINTS="https://api.mainnet-beta.solana.com,https://solana-api.projectserum.com,https://rpc.ankr.com/solana"

# API Configuration
API_PORT=3000
API_HOST=0.0.0.0
NODE_ENV=development

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Cache Configuration
CACHE_TTL=300
POOL_CACHE_TTL=60
QUOTE_CACHE_TTL=30

# Indexer Configuration
INDEXER_INTERVAL_MS=5000
MAX_CONCURRENT_REQUESTS=10

# Protocol Specific Program IDs
RAYDIUM_AMM_PROGRAM_ID="675kPX9MHTjS2zt1qfr1NYHuzeLXfQM9H24wFSUt1Mp8"
RAYDIUM_CLMM_PROGRAM_ID="CAMMCzo5YL8w4VFF8KVHrK22GGUQp5KpKpKpKpKpKpKpKpKp"
ORCA_WHIRLPOOL_PROGRAM_ID="whirLbMiicVdio4qvUfM5KAg6Ct8VwpYzGff3uctyCc"
METEORA_DLMM_PROGRAM_ID="LBUZKhRxPF3XUpBCjp4YzTKgLccjZhTSDM9YuVaPwxo"

# Security
JWT_SECRET="your-super-secret-jwt-key"
API_KEY="your-api-key-for-external-access"

# Monitoring
SENTRY_DSN=""
PROMETHEUS_PORT=9090

# Development
DEBUG=false
ENABLE_SWAGGER=true
